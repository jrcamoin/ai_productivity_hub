{
  "name": "orbit-ai-productivity-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "ci": "npm run db:generate && npm run typecheck && npm run lint && npm test && npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:generate:production": "node scripts/prepare-production-schema.mjs && prisma generate --schema prisma/schema.production.prisma",
    "db:push": "prisma db push",
    "db:push:production": "node scripts/prepare-production-schema.mjs && prisma db push --schema prisma/schema.production.prisma",
    "db:migrate:production": "node scripts/prepare-production-schema.mjs && prisma migrate deploy --schema prisma/schema.production.prisma",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.9.1",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^7.3.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.15.30",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.4",
    "prisma": "^6.12.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "gaxios": {
      "rimraf": "^6.0.1"
    }
  }
}
