{
  "name": "orbit-ai-productivity-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "ci": "npm run db:generate && npm run typecheck && npm run lint && npm test && npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:generate:production": "node scripts/prepare-production-schema.mjs && prisma generate --schema prisma/schema.production.prisma",
    "db:push": "prisma db push",
    "db:push:production": "node scripts/prepare-production-schema.mjs && prisma db push --schema prisma/schema.production.prisma",
    "db:migrate:production": "node scripts/prepare-production-schema.mjs && prisma migrate deploy --schema prisma/schema.production.prisma",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@aws-sdk/client-s3": "^3.850.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.12.0",
    "googleapis": "^156.0.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.1",
    "next": "^15.3.4",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^5.10.1",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^18.3.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "gaxios": {
      "rimraf": "^6.0.1"
    }
  }
}
